// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Hot Wheels trading marketplace ----------
// Simple classifieds model: users post listings with photos, browsers message
// sellers in-app to negotiate, price/payment is settled off-platform.

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  googleId  String   @unique
  name      String?
  image     String?
  city      String?
  createdAt DateTime @default(now())

  listings           Listing[]
  sentMessages       Message[]
  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  favorites          Favorite[]
}

enum ListingCondition {
  MINT
  NEAR_MINT
  GOOD
  PLAYED
  DAMAGED
}

enum ListingStatus {
  ACTIVE
  RESERVED
  SOLD
  REMOVED
}

model Listing {
  id          String           @id @default(cuid())
  sellerId    String
  title       String
  description String
  castingName String? // the specific Hot Wheels casting/model name, if known
  series      String? // e.g. "Mainline", "Premium", "Treasure Hunt", "RLC"
  condition   ListingCondition @default(GOOD)
  priceInr    Int
  city        String
  status      ListingStatus    @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  images        ListingImage[]
  conversations Conversation[]
  favoritedBy   Favorite[]

  @@index([status, createdAt])
  @@index([sellerId])
}

model ListingImage {
  id        String @id @default(cuid())
  listingId String
  url       String
  position  Int    @default(0)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// One conversation per (listing, buyer) pair — the seller is implied by the listing.
model Conversation {
  id        String   @id @default(cuid())
  listingId String
  buyerId   String
  sellerId  String
  createdAt DateTime @default(now())

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([listingId, buyerId])
  @@index([sellerId])
  @@index([buyerId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}
